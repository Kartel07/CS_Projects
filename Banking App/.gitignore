# ── NODEJS / DEPENDENCIES ──
# Never commit the massive node_modules folder; it is rebuilt on deploy via 'npm install'
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
.pnpm-store/

# ── ENVIRONMENT SECRETS & CRYPTOGRAPHY ──
.env
.env.local
.env.production
.env.development
*.pem
*.key
*.cert

# ── APPLICATION PRODUCTION LOGS ──
# Keeps persistent text file logging engines localized to your environment
Backend/logs/
*.log
logs/

# ── DATABASE ARTIFACTS ──
# Excludes active database management files and local container storage sheets
Backend/setup.sql
.data/
mysql_data/
*.sql.gz
*.sqlite

# ── OPERATING SYSTEM CACHES ──
# Local layout configurations generated by macOS or Windows file systems
.DS_Store
Thumbs.db
Desktop.ini

# ── IDE / VISUAL STUDIO CODE CONFIGURATIONS ──
# Local editor history workspaces and workspace cache lines
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.project